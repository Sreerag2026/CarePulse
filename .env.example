# Copy this file to .env for local development. On Render, add the same keys under Environment.

# MongoDB connection string (MongoDB Atlas → Connect → Drivers).
# URL-encode special characters in the password, e.g. @ → %40, # → %23.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (default: carepulse)
DB_NAME=carepulse

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: shared key the monitoring device sends in the x-device-key header
# when posting readings. If empty, anyone can post readings.
DEVICE_API_KEY=

# Code doctors must enter to register on the website. Give it only to real doctors.
# Leave empty to close doctor registration. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(6).toString('hex'))"
DOCTOR_SIGNUP_CODE=

# Port for local development (Render sets this automatically)
PORT=3000
